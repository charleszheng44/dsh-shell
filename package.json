{
  "name": "dsh-shell",
  "version": "0.0.0",
  "private": true,
  "description": "A thin terminal companion for an already-running DeepSeek Harness host",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charleszheng44/dsh-shell.git"
  },
  "homepage": "https://github.com/charleszheng44/dsh-shell#readme",
  "bugs": {
    "url": "https://github.com/charleszheng44/dsh-shell/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "terminal",
    "tui"
  ],
  "type": "module",
  "bin": {
    "dsh-shell": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "c8 --all --include \"src/**/*.ts\" --reporter=text --reporter=lcov node --import tsx --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title": "0.1.0-rc.7",
    "@earendil-works/pi-tui": "^0.84.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "c8": "^12.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
